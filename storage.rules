rules_version = '2';

service firebase.storage {
    match /b/{bucket}/o {

        // Song audio files — read by any signed-in user
        match /songs/{songId}/{fileName} {
            allow read: if request.auth != null;
            allow write: if false; // Admin SDK only
        }

        // Album art — read by any signed-in user
        match /artwork/{fileName} {
            allow read: if request.auth != null;
            allow write: if false;
        }

        // User profile images
        match /users/{userId}/{fileName} {
            allow read: if true; // Publicly readable profiles
            allow write: if request.auth != null && request.auth.uid == userId;
        }

        // Deny everything else (base case)
        match /{allPaths=**} {
            allow read: if request.auth != null;
            allow write: if false;
        }
    }
}